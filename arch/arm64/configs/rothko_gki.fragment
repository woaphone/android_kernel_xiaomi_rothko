# MT6989 / rothko, 4 KiB pages on the Android 17 common kernel.
CONFIG_ARCH_MEDIATEK=y
CONFIG_LOCALVERSION="-rothko-6.18-4k"
# ARCH_MEDIATEK also enables these unrelated MT8196 modules by default.
# CONFIG_COMMON_CLK_MT8196_MFGCFG is not set
# CONFIG_COMMON_CLK_MT8196_MMSYS is not set
# CONFIG_COMMON_CLK_MT8196_VDECSYS is not set
# CONFIG_COMMON_CLK_MT8196_VENCSYS is not set
CONFIG_COMMON_CLK_MT6989=y
CONFIG_COMMON_CLK_MT6989_ADSP=y
CONFIG_COMMON_CLK_MT6989_BUS=y
CONFIG_COMMON_CLK_MT6989_CAM=y
CONFIG_COMMON_CLK_MT6989_IMG=y
CONFIG_COMMON_CLK_MT6989_MDPSYS=y
# CONFIG_COMMON_CLK_MT6989_MFGCFG is not set
CONFIG_COMMON_CLK_MT6989_MMSYS=y
CONFIG_COMMON_CLK_MT6989_PERI=y
CONFIG_COMMON_CLK_MT6989_VCODEC=y
CONFIG_COMMON_CLK_MT6989_VLP=y
CONFIG_PINCTRL_MT6989=y
CONFIG_MTK_ROTHKO_SOCINFO=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_MTK_UART_APDMA=y

# Stock MT6989 storage power and PHY providers.
CONFIG_SPMI=y
CONFIG_SPMI_MT6989_PMIF=y
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_MFD_MT6681=y
CONFIG_MFD_MT6685=y
CONFIG_RTC_DRV_MT6685=y
CONFIG_MFD_MT6375=y
CONFIG_MEDIATEK_MT6375_ADC=y
CONFIG_MEDIATEK_MT6375_AUXADC=y
CONFIG_MEDIATEK_SPMI_PMIC_ADC=y
CONFIG_GAUGE_MT6375=y
CONFIG_MTK_USB_TYPEC=y
CONFIG_MTK_USB_TYPEC_MUX=y
CONFIG_TCPC_CLASS=y
CONFIG_USB_POWER_DELIVERY=y
CONFIG_TCPC_MT6375=y
CONFIG_MTK_TYPEC_WATER_DETECT=y
CONFIG_MTK_CHARGER=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_MTK_CHARGER_TYPE_DETECT=y
CONFIG_CHARGER_MT6375=y
CONFIG_MTK_PUMP_EXPRESS=y
CONFIG_MTK_ROTHKO_USB_POWER_SUPPLY=y
CONFIG_ROTHKO_SC858X_READBACK=y
CONFIG_REGULATOR_MT6316=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6373=y
CONFIG_REGULATOR_MT6681=y
CONFIG_MTK_DVFSRC=y
CONFIG_REGULATOR_MTK_DVFSRC=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_SCSI_UFS_ROTHKO=y
CONFIG_PHY_MTK_UFS=y
CONFIG_ARM_SCMI_TRANSPORT_SMC=y

# Real MT6989 USB hardware providers; keep the stock dual-role policy.
CONFIG_MTK_SCPSYS_MT6989=y
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_NVMEM_MT635X_EFUSE=m
CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_MTU3=y
# MTU3 defaults to dual role; the diagnostic fragment selects gadget mode.
CONFIG_USB_XHCI_MTK=y

# Single-boot test image: do not depend on the stock 6.1 board modules.
CONFIG_I2C_MT65XX=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_MTK_ROTHKO_LPM=y

# The stock cgroups.json mounts the memory controller under /dev/memcg.
CONFIG_MEMCG_V1=y

# The stock PerfInit service expects zram0 on the single-boot test image.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# Rebuilt peripheral and native GT9916 touch input paths.
CONFIG_SPI_MT65XX=y
CONFIG_COMMON_CLK_MT6685_335=y
CONFIG_ROTHKO_HWID=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y
CONFIG_TOUCHSCREEN_FT3683_ROTHKO=y
CONFIG_XIAOMI_TOUCH_COMMON_ROTHKO=y
CONFIG_ROTHKO_THN31_NFC=y
CONFIG_ROTHKO_AW8697_HAPTIC=y

# Rebuilt MT6989 modem transport and connection infrastructure.
CONFIG_MTK_CCCI_DEVICES=y
CONFIG_MTK_ECCCI_DRIVER=y
CONFIG_MTK_MDPM=y
CONFIG_MTK_ROTHKO_DLPT=y
CONFIG_MTK_ECCCI_CLDMA=y
CONFIG_MTK_ECCCI_CCIF=y
CONFIG_MTK_MD1_SUPPORT=25
CONFIG_MTK_NET_CCMNI=y
CONFIG_MTK_NET_RPS=y
CONFIG_MTK_CONN_MD=y
CONFIG_MTK_AMMS=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PHY_MTK_PCIE=y
CONFIG_CFG80211=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MTK_ROTHKO_CONNINFRA=y
CONFIG_MTK_ROTHKO_WLAN=y
CONFIG_MTK_ROTHKO_GPS_SCP=y
CONFIG_MTK_ROTHKO_GPS_DATA_LINK=y
CONFIG_ROTHKO_MINET=m
CONFIG_ROTHKO_MIWILL=m
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_MTK_ROTHKO_BT=y
CONFIG_MTK_UARTHUB=y

# Actual Tinysys and MiTEE FF-A message transports.
CONFIG_MAILBOX=y
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_TRANSPORT_MAILBOX=y
CONFIG_MTK_TINYSYS_MBOX=y
CONFIG_MTK_TINYSYS_SCMI=y
CONFIG_MTK_CM_IPI=y
CONFIG_MTK_CM_MGR=y
CONFIG_MTK_CM_MGR_MT6989=y
CONFIG_MTK_ROTHKO_IRTX_PWM=m
CONFIG_MTK_ISE_MBOX=y
CONFIG_MTK_ISE_LPM_SUPPORT=y
CONFIG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_LOGGER_SUPPORT=y
CONFIG_MTK_SENSOR_SUPPORT=y
CONFIG_MTK_SENSORHUB=y
CONFIG_MTK_CONN_SCP=y
CONFIG_RPMSG=y
CONFIG_RPMSG_MTK=y
CONFIG_TEE=y
CONFIG_ARM_FFA_TRANSPORT=y
CONFIG_MTK_MITEE=y
CONFIG_MTK_ENABLE_GENIEZONE=y
CONFIG_MTK_GZ_IRQ=y
CONFIG_MTK_GZ_VIRTIO=y
CONFIG_MTK_GZ_VIRTIO_IPC=y
CONFIG_MTK_GZ_TZ_SYSTEM=y
# CONFIG_OPTEE is not set
CONFIG_MTK_TRUSTED_MEMORY_SUBSYSTEM=y
CONFIG_MTK_PROT_MEM_SUPPORT=y
CONFIG_MTK_SECURE_MEM_SUPPORT=y
CONFIG_MTK_WFD_SMEM_SUPPORT=y
CONFIG_MTK_PROT_MEM_SSHEAP_V2=y
# CONFIG_MTK_GZ_KREE is not set
# CONFIG_ALLOC_TMEM_WITH_HIGH_FREQ is not set
# CONFIG_TEST_MTK_TRUSTED_MEMORY is not set

# Real DRAMC provider for display EMI efficiency selection.
CONFIG_MEMORY=y
CONFIG_MTK_DRAMC=y

# MT6989 vendor display paths and their actual command queue.
# CONFIG_DRM_MEDIATEK is not set
CONFIG_DRM_MEDIATEK_MT6989=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_ROTHKO_N12=y
CONFIG_MTK_MML=y
CONFIG_MTK_DPC=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_MDP_MT6989=y
CONFIG_MTK_SLBC=y
CONFIG_MTK_SLBC_MT6989=y
CONFIG_MTK_SLBC_IPI=y
CONFIG_MTK_SLBC_TRACE=y
CONFIG_DEVICE_MODULES_ARM_SMMU_V3=y
CONFIG_MTK_MT6989_SMMU_SHARE_GROUP=y
CONFIG_MTK_IOMMU_MISC_SECURE=y
# CONFIG_ARM_SMMU_V3 is not set
CONFIG_DEVICE_MODULES_MTK_SMI=y
# CONFIG_MTK_SMI is not set
CONFIG_MTK_MMDVFS=y
CONFIG_MTK_TINYSYS_VCP_SUPPORT=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_MTK=y
CONFIG_INTERCONNECT_MTK_EXTENSION=y
CONFIG_INTERCONNECT_MTK_MMQOS_COMMON=y
CONFIG_INTERCONNECT_MTK_MMQOS_MT6989=y
CONFIG_MTK_MMQOS_VCP=y
CONFIG_INTERCONNECT_MTK_EMI=y
CONFIG_VIDEO_MTK_ISP_HCP=y
CONFIG_VIDEO_ROTHKO_VENC=y
CONFIG_VIDEO_ROTHKO_VDEC=y
CONFIG_VIDEO_ROTHKO_JPEG=y
CONFIG_VIDEO_MEDIATEK_JPEG=y
CONFIG_VIDEO_ROTHKO_CAMERA=y
CONFIG_VIDEO_ROTHKO_CAMERA_TORCH=y
CONFIG_VIDEO_ROTHKO_CAMERA_AF=m
CONFIG_VIDEO_ROTHKO_CAMERA_PDA=m
CONFIG_VIDEO_ROTHKO_CAMERA_DPE=m
CONFIG_VIDEO_ROTHKO_CAMERA_EEPROM=m
CONFIG_CUSTOM_KERNEL_IMGSENSOR="rothkoimx906wide_mipi_raw rothkoov50h40wide_mipi_raw rothkoimx355ultra_mipi_raw rothkoov13b10ultra_mipi_raw rothkogc02m1macro_mipi_raw rothkoov20bfront_mipi_raw rothkos5kkd1front_mipi_raw rothkos5kjn1tele_mipi_raw"
CONFIG_RPMSG=y
CONFIG_SND_SOC_ROTHKO_MT6989=y
CONFIG_MEDIATEK_MT6681_AUXADC=y
CONFIG_MT6681_EFUSE=y
CONFIG_MT6685_AUDCLK=y
CONFIG_MTK_PEAK_POWER_BUDGET=y
CONFIG_MTK_BATTERY_OC_POWER_THROTTLING=y
CONFIG_MTK_LOW_BATTERY_POWER_THROTTLING=y
CONFIG_PMIC_LBAT_SERVICE=y
CONFIG_VIDEO_MTK_ISP_IMGSYS_7SP=y
CONFIG_MTPROF=y
CONFIG_LEDS_MTK=y
CONFIG_LEDS_MTK_DISP=y
# CONFIG_PXLW_IRIS is not set

# Mali r44p1 CSF and the MT6989 GPUEB/GED power control path.
CONFIG_MTK_GPU_SUPPORT=y
CONFIG_MTK_GPUFREQ_V2=y
CONFIG_MTK_GPU_MT6989_SUPPORT=y
CONFIG_MTK_TINYSYS_GPUEB_SUPPORT=y
CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT=y
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_REAL_HW=y
CONFIG_MALI_MIDGARD_DVFS=y
CONFIG_MALI_PLATFORM_NAME="mt6989"
CONFIG_MALI_MEMORY_GROUP_MANAGER=y
CONFIG_MALI_PROTECTED_MEMORY_ALLOCATOR=y
CONFIG_MALI_MTK_GPU_IOMMU=y
CONFIG_MALI_MTK_GPUEB_IRQ=y
CONFIG_MALI_MTK_MEMTRACK=y
# CONFIG_MALI_DEVFREQ is not set
# CONFIG_MALI_KUTF is not set
# CONFIG_MALI_NO_MALI is not set
# CONFIG_MALI_MTK_MGMM is not set
# CONFIG_MALI_MTK_SLC_ALL_CACHE_MODE is not set
CONFIG_PM_DEVFREQ=y
CONFIG_MTK_ROTHKO_DDR_DEVFREQ=y
CONFIG_MTK_PERFORMANCE_MODULE=y
CONFIG_MTK_FPSGO_V3=y
CONFIG_MTK_C2PS=y
CONFIG_MTK_FPSGO_NATIVE_XGF=y
CONFIG_MTK_FPSGO_DDR_RESCUE_DEFAULT=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_MT6989=y
CONFIG_MTK_BOARD_THERMAL=y
CONFIG_MTK_PMIC_TEMP=m
CONFIG_MTK_CHARGER_COOLING=m
CONFIG_MTK_BACKLIGHT_COOLING=m
CONFIG_XIAOMI_THERMAL_MESSAGE=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_FW_LOADER=y
# Stock Android 15 reads per-buffer memory accounting from sysfs.
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_DEVICE_MODULES_DMABUF_HEAPS_SYSTEM=y
# CONFIG_DMABUF_HEAPS_SYSTEM is not set
CONFIG_ANDROID_KABI_RESERVE=y
# CONFIG_DEVICE_MODULES_DMABUF_HEAPS_REFILL is not set
# CONFIG_DMABUF_HEAPS_DEBUG is not set

# Preserve the standard hand-off for a boot-enabled hardware watchdog.
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# Keep LK clocks until the rebuilt board consumers take ownership.
CONFIG_CMDLINE="console=ttynull stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off kvm-arm.mode=protected bootconfig clk_ignore_unused"

CONFIG_REGULATOR_ROTHKO_WL2868C=y
